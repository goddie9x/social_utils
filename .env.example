# Copy to .env and set real values for production.
# Defaults in docker-compose.yaml are for local dev only.

# JWT signing secret (base64). MUST match across user-service, socket-gateway, api-gateway.
JWT_SECRET=dev-only-change-me
JWT_REFRESH_TOKEN_SECRET=dev-only-change-me

# HMAC secret for gateway -> service internal auth. MUST match across all services.
INTERNAL_HMAC_SECRET=dev-only-change-me

# MongoDB
MONGO_ROOT_USER=goddie9x
MONGO_ROOT_PASSWORD=change-me-in-prod
MONGO_APP_USER=goddie9x
MONGO_APP_PASSWORD=change-me-in-prod

# Redis
REDIS_PASSWORD=change-me-in-prod

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-prod

# Oracle XE
ORACLE_PASSWORD=change-me-in-prod

# Elasticsearch
ELASTIC_PASSWORD=change-me-in-prod
